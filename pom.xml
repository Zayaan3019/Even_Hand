<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>in.ac.iitm.evenhand</groupId>
  <artifactId>even-hand</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Even Hand</name>
  <description>A grading-consistency audit for IIT Madras courses (CS5013 project, team God's Eye)</description>

  <!--
    ONE PIPELINE, NINE MODULES.

    This is a single end-to-end system, built and delivered as one: `mvnw verify`
    compiles and tests all of it, and a course goes in at eh-ingest and comes out
    as a report at eh-report without leaving the reactor. The modules are stages of
    that pipeline, not separable deliverables.

      eh-core      shared vocabulary: records, sealed verdicts, CourseProfile
      eh-numerics  linear algebra, exact rational elimination, seeded RNG
      eh-ingest    CSV parsing and pseudonymisation
      eh-design    profiler, identifiability audit, precision forecast
      eh-estimate  many-facet Rasch estimation, drift, uncertainty
      eh-linking   minimum additional marking to reach a stated precision
      eh-outcome   grading rules, transfers, shortlist
      eh-report    narration and exports
      eh-app       Spring Boot / Thymeleaf / SQLite and the CLI

    The split is by responsibility, and the dependency graph flows strictly downward
    so that it stays that way. The useful consequence is that eh-estimate is not
    offered Spring, JPA or SQLite by its POM: "the estimator has tests that run
    without a database" is therefore a property of the build rather than a matter of
    discipline. Review responsibility per module is recorded in .github/CODEOWNERS.
  -->
  <modules>
    <module>eh-core</module>
    <module>eh-numerics</module>
    <module>eh-ingest</module>
    <module>eh-design</module>
    <module>eh-estimate</module>
    <module>eh-linking</module>
    <module>eh-outcome</module>
    <module>eh-report</module>
    <module>eh-app</module>
  </modules>

  <properties>
    <!-- Course policy is Java 21. Local JDKs may be newer; release=21 makes the
         bytecode level a fact rather than a hope. -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jqwik.version>1.9.2</jqwik.version>
    <archunit.version>1.3.0</archunit.version>
    <sqlite.jdbc.version>3.49.1.0</sqlite.jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-numerics</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-ingest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-design</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-estimate</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-linking</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-outcome</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.jdbc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Test-scope only, in every module. No third-party numerics ever reach the
         production classpath: the estimation code in Section 5 of the proposal is
         ours and is examinable. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Statistical calibration tests are slow and seeded; excluded from
                 the default build and run by -Pstats. -->
            <excludedGroups>slow</excludedGroups>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <!-- ./mvnw -Pstats verify : runs the parameter-recovery and interval-coverage
           studies that back the numbers quoted in the report. -->
      <id>stats</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
