<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>in.ac.iitm.evenhand</groupId>
  <artifactId>even-hand</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Even Hand</name>
  <description>A grading-consistency audit for IIT Madras courses (CS5013 project, team God's Eye)</description>

  <!--
    ONE PIPELINE, EIGHT MODULES. A course goes in at eh-ingest and comes out as a
    report from eh-report; `mvnw verify` builds and tests all of it.

      eh-core      shared vocabulary: records, sealed verdicts, grades, the FittedModel seam
      eh-numerics  exact integer rank for the audit
      eh-ingest    CSV parsing and pseudonymisation          (stage 1)
      eh-design    who-marked-what audit; IITM course simulator (stage 2)
      eh-estimate  TA severity in marks, bootstrap, no-effect test (stage 3)
      eh-outcome   IITM grading rules, grade changes, re-check list (stage 4)
      eh-report    HTML report and Class Committee sheet       (stage 5)
      eh-app       command-line tool and the benchmark

    Dependencies flow strictly downward. No module has a third-party runtime
    dependency: the arithmetic is ours and examinable. Review responsibility per
    module is recorded in .github/CODEOWNERS.
  -->
  <modules>
    <module>eh-core</module>
    <module>eh-numerics</module>
    <module>eh-ingest</module>
    <module>eh-design</module>
    <module>eh-estimate</module>
    <module>eh-outcome</module>
    <module>eh-report</module>
    <module>eh-app</module>
  </modules>

  <properties>
    <!-- Course policy is Java 21. Local JDKs may be newer; release=21 makes the
         bytecode level a fact rather than a hope. -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jqwik.version>1.9.2</jqwik.version>
    <archunit.version>1.3.0</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-numerics</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-ingest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-design</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-estimate</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-outcome</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>in.ac.iitm.evenhand</groupId>
        <artifactId>eh-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Test-scope only, in every module. No third-party numerics ever reach the
         production classpath: the estimation code in Section 5 of the proposal is
         ours and is examinable. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Line and branch coverage for every module: target/site/jacoco/index.html -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Statistical calibration tests are slow and seeded; excluded from
                 the default build and run by -Pstats. -->
            <excludedGroups>slow</excludedGroups>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <!-- ./mvnw -Pmutation verify -pl eh-outcome : PIT mutation testing of the arithmetic that
           decides grades. The estimator is not mutated: its tests run full bootstraps, so every
           mutant times out; its correctness is checked by the benchmark instead. -->
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.21.0</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>in.ac.iitm.evenhand.outcome.*</param>
              </targetClasses>
              <outputFormats><param>HTML</param><param>CSV</param></outputFormats>
              <timestampedReports>false</timestampedReports>
              <skip>${pit.skip}</skip>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- ./mvnw -Pstats verify : runs the parameter-recovery and interval-coverage
           studies that back the numbers quoted in the report. -->
      <id>stats</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
