# Normalise to LF in the repository. Without this the wrapper script is checked
# out with CRLF on Windows, committed that way, and then fails on the Linux CI
# runner with a "bad interpreter" error that is tedious to diagnose.
* text=auto eol=lf

# The wrapper must stay LF and executable wherever it is checked out.
mvnw text eol=lf
mvnw.cmd text eol=crlf

*.pdf binary
*.jar binary
