<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.ac.iitm.evenhand</groupId>
    <artifactId>even-hand</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>eh-app</artifactId>
  <name>eh-app</name>
  <!-- Primary reviewer: Pruthviraj (see .github/CODEOWNERS) -->
  <description>
    The only module that knows about HTTP, Spring, Hibernate or SQLite. It binds to
    127.0.0.1 and makes no outbound network call; both facts are asserted by tests.
  </description>

  <dependencies>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-ingest</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-design</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-estimate</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-linking</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-outcome</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-report</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <version>${hibernate.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
