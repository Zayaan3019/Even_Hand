<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>in.ac.iitm.evenhand</groupId>
    <artifactId>even-hand</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>eh-design</artifactId>
  <name>eh-design</name>
  <!-- Primary reviewer: Zayaan (see .github/CODEOWNERS) -->
  <description>Design profiler, identifiability audit, design-only precision forecast. Its tests carry the course simulator.</description>

  <dependencies>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-core</artifactId>
    </dependency>
    <dependency>
      <groupId>in.ac.iitm.evenhand</groupId>
      <artifactId>eh-numerics</artifactId>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The course simulator lives in the tests: it is a test fixture, never part of the product.
           Other modules' tests and eh-validation use it through this test-jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
