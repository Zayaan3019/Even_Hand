target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar
*.class
*.db
*.sqlite
*.log

# Never commit real marks, identities, or the pseudonymisation key.
data/
keys/
runs/
*.csv
!src/test/resources/**/*.csv
!docs/**/*.csv
# Synthetic courses only: every file under samples/ is generated by the simulator.
!samples/**/*.csv
even-hand-report/

.idea/
*.iml
.vscode/
.DS_Store

# jqwik keeps a local database of failing examples; it is per-machine state.
.jqwik-database

# A local copy of the embedding model (fetched by scripts/fetch-model); never committed.
models/
*.part

# Third-party data used only to validate accuracy (scripts/validate.sh); never committed.
validation-data/

# The web app's dependencies and the Node that Maven fetches; restored by npm ci.
node_modules/
